--cpu Cortex-M3
"08-keyint\startup_stm32f103xb.o"
"08-keyint\main.o"
"08-keyint\gpio.o"
"08-keyint\stm32f1xx_it.o"
"08-keyint\stm32f1xx_hal_msp.o"
"08-keyint\stm32f1xx_hal_gpio_ex.o"
"08-keyint\stm32f1xx_hal.o"
"08-keyint\stm32f1xx_hal_rcc.o"
"08-keyint\stm32f1xx_hal_rcc_ex.o"
"08-keyint\stm32f1xx_hal_gpio.o"
"08-keyint\stm32f1xx_hal_dma.o"
"08-keyint\stm32f1xx_hal_cortex.o"
"08-keyint\stm32f1xx_hal_pwr.o"
"08-keyint\stm32f1xx_hal_flash.o"
"08-keyint\stm32f1xx_hal_flash_ex.o"
"08-keyint\stm32f1xx_hal_exti.o"
"08-keyint\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "08-keyint\08-keyint.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "08-keyint.map" -o 08-keyint\08-keyint.axf